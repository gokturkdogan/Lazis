;; LAZIS backend network sandbox — macOS Seatbelt profile, applied by the desktop shell with
;; /usr/bin/sandbox-exec. The kernel enforces it for the backend and every process it starts,
;; including native code that bypasses Python. Verified by core/tests/security/test_os_sandbox.py
;; and apps/desktop/src-tauri/tests/lifecycle.rs.
;;
;; * Outbound: only to the local inference runtime (Ollama) on port 11434 of this machine
;;   (Phase 2). In a *remote* filter "localhost" matches loopback and this host's own addresses;
;;   the port restriction means no other local service (e.g. a proxy) is reachable either, so
;;   nothing can be relayed to another host. The port must match models.endpoint
;;   (core/src/lazis/config/model.py, OLLAMA_PORT).
;; * DNS: the resolver daemon's Unix socket falls under (deny network*), so no name can be
;;   resolved.
;; * Bind / inbound: Seatbelt cannot express "127.0.0.1 only" (in a *local* filter "localhost"
;;   means any local address). Loopback-only listening is enforced inside the backend
;;   (validated config + the audit-hook guard), not by this profile.
;; * Research (Phase 12, ADR-0009): the backend still cannot reach the internet. It may connect
;;   to exactly one Unix socket, the research helper's (param EGRESS_SOCKET, given by the shell;
;;   a path that does not exist when the helper is not running). The helper runs under its own
;;   profile (sandbox/egress.sb) and does the web requests.
;; * Everything else (files, Keychain, processes) is unrestricted here; file permissions and the
;;   backend's own guard cover those.
(version 1)
(allow default)
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:11434"))
(allow network-outbound (remote unix-socket (path-literal (param "EGRESS_SOCKET"))))
