{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main window only: the LAZIS shell commands and their events. No shell, filesystem, HTTP, opener or other plugins are enabled; external links go through the validated open_external_url command.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-backend-connection",
    "allow-retry-backend",
    "allow-reveal-recovery-code",
    "allow-acknowledge-recovery",
    "allow-restore-from-recovery-code",
    "allow-get-preferences",
    "allow-set-preferences",
    "allow-set-tray-status",
    "allow-open-external-url",
    "allow-process-metrics"
  ]
}
