{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main window only: the five LAZIS shell commands and backend-connection events. No shell, filesystem, HTTP, opener or other plugins are enabled.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-backend-connection",
    "allow-retry-backend",
    "allow-reveal-recovery-code",
    "allow-acknowledge-recovery",
    "allow-restore-from-recovery-code"
  ]
}
